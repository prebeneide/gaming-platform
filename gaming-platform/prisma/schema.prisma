// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  password    String
  displayName String?
  bio         String?
  image       String?
  discord     String?
  twitter     String?
  twitch      String?
  steam       String?
  psn         String?
  xbox        String?
  customGames Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastActiveAt DateTime?

  // Relations
  followers           Follower[] @relation("UserFollowers")
  following           Follower[] @relation("UserFollowing")
  friendRequestsSent  FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")
  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")
  wallet              UserWallet?
  transactions        Transaction[]
  createdMatches      Match[] @relation("CreatedMatches")
  matchParticipations MatchParticipant[] @relation("MatchParticipations")
  stats               UserStats?
  notifications       Notification[]
}

model UserStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Statistikk
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  winPercent    Float    @default(0)
  winLossRatio  Float    @default(0)
  rank          String   @default("Iron")
  
  // Form (last 10 results)
  last10Results String[] // ["W", "L", "D", ...]
  
  // Timestamps
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification details
  type      String   // 'match_invite', 'friend_request', 'match_result', 'payment', 'system'
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?    // Additional data like matchId, userId, amount, etc.
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // 'deposit', 'withdrawal', 'match_payment', 'match_winning'
  amount      Float
  status      String   // 'pending', 'completed', 'failed'
  description String
  externalId  String?  // For MoonPay transaction ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Follower {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  follower   User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following  User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followingId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  from      User     @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, accepted, rejected
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId  String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
}

model Match {
  id                String   @id @default(cuid())
  name              String
  gameName          String   // FC25, Fortnite, etc.
  gameMode          String   // Ultimate Team, Battle Royale, etc.
  competitionType   String   // Win, Most Kills, etc.
  competitionFormat String   // 1v1, 1v1v1, etc.
  matchType         String?  // versus, coop (nullable for games that don't need it)
  platform          String   // PC, PS5, Xbox, etc.
  buyIn             Float    // Entry fee amount
  totalPot          Float    // Total pot (buyIn * numPlayers)
  potentialWinnings Float    // Pot minus platform fee
  visibility        String   // public, friends, invite_only
  status            String   @default("open") // open, in_progress, completed, cancelled
  maxPlayers        Int      // Number of players needed
  currentPlayers    Int      @default(1) // Number of players joined
  mediaUrl          String?  // URL to uploaded image/video
  mediaType         String?  // image, video
  
  // Creator and participants
  creatorId         String
  creator           User     @relation("CreatedMatches", fields: [creatorId], references: [id], onDelete: Cascade)
  participants      MatchParticipant[]
  
  // Resultat
  result            MatchResult?
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  scheduledAt       DateTime? // When the match is scheduled to start
  startedAt         DateTime? // When the match actually started
  completedAt       DateTime? // When the match was completed
}

model MatchParticipant {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation("MatchParticipations", fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("joined") // joined, ready, playing, completed
  buyInPaid Boolean  @default(false) // Whether they've paid their buy-in
  buyInTransactionId String? // Reference to the transaction that paid the buy-in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resultat-relaterte felter
  hasReportedResult Boolean @default(false) // Om brukeren har rapportert resultat
  reportedWinnerId  String? // Hvem brukeren rapporterte som vinner
  reportedResult    String? // win, draw, problem
  proofImageUrl     String? // URL til opplastet bevis-bilde
  proofUploadedAt   DateTime? // Når beviset ble opplastet

  @@unique([matchId, userId])
}

model MatchResult {
  id          String   @id @default(cuid())
  matchId     String   @unique // En resultat per match
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  // Resultat-detaljer
  winnerId    String? // ID til vinneren (null for draw)
  resultType  String   // win, draw, problem
  status      String   @default("pending") // pending, agreed, disputed, completed
  
  // Konsensus
  agreedBy    String[] // Array av user IDs som er enige
  disputedBy  String[] // Array av user IDs som er uenige
  
  // Utbetaling
  payoutAmount Float? // Beløp som ble utbetalt
  payoutTransactionId String? // Reference til utbetalings-transaksjonen
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime? // Når resultatet ble endelig avgjort
}