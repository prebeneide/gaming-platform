generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  username               String             @unique
  password               String
  displayName            String?
  bio                    String?
  image                  String?
  discord                String?
  twitter                String?
  twitch                 String?
  steam                  String?
  psn                    String?
  xbox                   String?
  customGames            Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  lastActiveAt           DateTime?
  role                  String             @default("user")
  followers              Follower[]         @relation("UserFollowers")
  following              Follower[]         @relation("UserFollowing")
  friendRequestsSent     FriendRequest[]    @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[]    @relation("FriendRequestTo")
  createdMatches         Match[]            @relation("CreatedMatches")
  matchParticipations    MatchParticipant[] @relation("MatchParticipations")
  receivedMessages       Message[]          @relation("ReceivedMessages")
  sentMessages           Message[]          @relation("SentMessages")
  notifications          Notification[]
  transactions           Transaction[]
  UserGameRating         UserGameRating[]
  stats                  UserStats?
  wallet                 UserWallet?
  preferences            UserPreferences?
  activityLogs          ActivityLog[]
  matchInvitations      MatchInvitation[]
  globalMessages        GlobalMessage[]
  matchMessages         MatchMessage[]
}

model UserStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  winPercent    Float    @default(0)
  winLossRatio  Float    @default(0)
  rating        Int      @default(1200)
  ratingTier    String   @default("Unranked")
  last10Results String[]
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id         String   @id @default(cuid())
  userId     String   @unique
  currency   String   @default("USD")
  timezone   String   @default("UTC")
  locale     String   @default("en-US")
  dateFormat String   @default("MM/DD/YYYY")
  timeFormat String   @default("12")
  country    String?
  language   String   @default("en")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  status      String
  description String
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follower {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  from      User     @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model MatchInvitation {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Match {
  id                String             @id @default(cuid())
  name              String
  gameName          String
  gameMode          String
  competitionType   String
  competitionFormat String
  matchType         String?
  platform          String
  buyIn             Float
  totalPot          Float
  potentialWinnings Float
  visibility        String
  status            String             @default("open")
  maxPlayers        Int
  currentPlayers    Int                @default(1)
  mediaUrl          String?
  mediaType         String?
  creatorId         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  creator           User               @relation("CreatedMatches", fields: [creatorId], references: [id], onDelete: Cascade)
  participants      MatchParticipant[]
  result            MatchResult?
  invitations       MatchInvitation[]
  messages          MatchMessage[]
}

model MatchParticipant {
  id                 String    @id @default(cuid())
  matchId            String
  userId             String
  status             String    @default("joined")
  buyInPaid          Boolean   @default(false)
  buyInTransactionId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  hasReportedResult  Boolean   @default(false)
  reportedWinnerId   String?
  reportedResult     String?
  proofImageUrl      String?
  proofUploadedAt    DateTime?
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user               User      @relation("MatchParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchResult {
  id                  String    @id @default(cuid())
  matchId             String    @unique
  winnerId            String?
  resultType          String
  status              String    @default("pending")
  agreedBy            String[]
  disputedBy          String[]
  payoutAmount        Float?
  payoutTransactionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?
  match               Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model RatingChange {
  id               String   @id
  matchId          String
  userId           String
  gameName         String
  ratingBefore     Int
  ratingAfter      Int
  ratingChange     Int
  opponentRating   Int
  ratingDifference Int
  createdAt        DateTime @default(now())
}

model UserGameRating {
  id            String    @id
  userId        String
  gameName      String
  rating        Int       @default(1200)
  gamesPlayed   Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  draws         Int       @default(0)
  highestRating Int       @default(1200)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  lastGameAt    DateTime?
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameName])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g., "user_registered", "match_created", "rating_updated"
  entityType  String?  // e.g., "User", "Match", "Rating"
  entityId    String?  // ID of the affected entity
  details     Json?    // Additional details about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  // Optional relation to User (if action was performed by a user)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model GlobalMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@index([createdAt])
}

model MatchMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  matchId   String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@index([matchId])
  @@index([createdAt])
}
